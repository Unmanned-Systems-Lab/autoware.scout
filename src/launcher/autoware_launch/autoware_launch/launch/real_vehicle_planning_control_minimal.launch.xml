<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Essential parameters -->
  <arg name="map_path" default="$(find-pkg-share autoware_launch)/../../../../src/launcher/autoware_launch/ui/generated_maps/autoware_init_map" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="ez21_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="ez21_sensor_kit" description="sensor model name"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>

  <!-- launch module preset -->
  <arg name="planning_module_preset" default="default" description="planning module preset"/>
  <arg name="control_module_preset" default="real_vehicle_minimal" description="control module preset"/>
  <arg
    name="diagnostic_graph_aggregator_graph_path"
    default="$(find-pkg-share autoware_launch)/config/system/diagnostics/autoware-real-vehicle-minimal.yaml"
    description="diagnostic graph config"
  />
  <arg
    name="component_state_monitor_topic_path"
    default="$(find-pkg-share autoware_launch)/config/system/component_state_monitor/topics-real-vehicle-minimal.yaml"
    description="component state monitor topics for this launch"
  />
  <arg
    name="operation_mode_transition_manager_param_path"
    default="$(find-pkg-share autoware_launch)/config/control/operation_mode_transition_manager/operation_mode_transition_manager.real_vehicle_minimal.param.yaml"
    description="operation mode transition manager params for this launch"
  />

  <!-- Vehicle / localization -->
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" description="vehicle specific ID"/>
  <arg
    name="vehicle_interface_can_interface"
    default="can0"
    description="SocketCAN interface used by the EZ21 vehicle interface"
  />
  <arg name="ins_driver_can_interface" default="can0" description="SocketCAN interface used by the INS driver"/>
  <arg name="launch_vehicle_interface" default="false"/>
  <arg name="launch_fixposition_driver" default="true"/>
  <arg name="fixposition_config_path" default="$(find-pkg-share autoware_launch)/config/sensing/fixposition.yaml"/>
  <arg name="fixposition_extrinsics_calibrated" default="false"/>
  <arg name="fixposition_map_aligned" default="false"/>
  <arg name="localization_base_link_to_ins_x" default="0.0"/>
  <arg name="localization_base_link_to_ins_y" default="0.0"/>
  <arg name="localization_base_link_to_ins_z" default="0.0"/>
  <arg name="localization_base_link_to_ins_roll" default="0.0"/>
  <arg name="localization_base_link_to_ins_pitch" default="0.0"/>
  <arg name="localization_base_link_to_ins_yaw" default="0.0"/>
  <arg name="localization_map_projector_info_path" default="" description="optional map_projector_info.yaml path used as a fixed ENU origin for the INS driver"/>

  <!-- Tools -->
  <arg name="rviz" default="true" description="launch rviz"/>
  <arg name="launch_ui" default="false" description="launch runtime route/HMI UI server"/>

  <include file="$(find-pkg-share autoware_launch)/launch/autoware.launch.xml">
    <!-- Common -->
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
    <arg name="control_module_preset" value="$(var control_module_preset)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="vehicle_interface_can_interface" value="$(var vehicle_interface_can_interface)"/>

    <!-- Keep only the modules needed for real-vehicle planning/control verification -->
    <arg name="launch_pointcloud_container" value="false"/>
    <arg name="launch_vehicle" value="true"/>
    <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
    <arg name="launch_system" value="true"/>
    <arg name="launch_system_monitor" value="false"/>
    <arg name="diagnostic_graph_aggregator_graph_path" value="$(var diagnostic_graph_aggregator_graph_path)"/>
    <arg name="component_state_monitor_topic_path" value="$(var component_state_monitor_topic_path)"/>
    <arg name="launch_map" value="true"/>
    <arg name="launch_sensing" value="false"/>
    <arg name="launch_localization" value="true"/>
    <arg name="launch_ins_driver" value="false"/>
    <arg name="ins_driver_can_interface" value="$(var ins_driver_can_interface)"/>
    <arg name="localization_map_projector_info_path" value="$(var localization_map_projector_info_path)"/>
    <arg name="localization_input_odom_topic" value="/fixposition/odometry_enu"/>
    <arg name="localization_output_base_link_odom_topic" value="/odom_ins_at_base_link"/>
    <arg name="localization_base_link_to_ins_x" value="$(var localization_base_link_to_ins_x)"/>
    <arg name="localization_base_link_to_ins_y" value="$(var localization_base_link_to_ins_y)"/>
    <arg name="localization_base_link_to_ins_z" value="$(var localization_base_link_to_ins_z)"/>
    <arg name="localization_base_link_to_ins_roll" value="$(var localization_base_link_to_ins_roll)"/>
    <arg name="localization_base_link_to_ins_pitch" value="$(var localization_base_link_to_ins_pitch)"/>
    <arg name="localization_base_link_to_ins_yaw" value="$(var localization_base_link_to_ins_yaw)"/>
    <arg name="fixposition_status_topic" value="/fixposition/fpa/odomstatus"/>
    <arg name="fixposition_extrinsics_calibrated" value="$(var fixposition_extrinsics_calibrated)"/>
    <arg name="fixposition_map_aligned" value="$(var fixposition_map_aligned)"/>
    <arg name="launch_perception" value="false"/>
    <arg name="launch_planning_dummy_publishers" value="true"/>
    <arg name="launch_planning" value="true"/>
    <arg name="launch_control" value="true"/>
    <arg name="operation_mode_transition_manager_param_path" value="$(var operation_mode_transition_manager_param_path)"/>
    <arg name="launch_api" value="true"/>

    <!-- Real-vehicle defaults -->
    <arg name="system_run_mode" value="online"/>
    <arg name="use_sim_time" value="false"/>
    <arg name="is_simulation" value="false"/>
    <arg name="launch_dummy_diag_publisher" value="false"/>

    <!-- Tools -->
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="launch_ui" value="$(var launch_ui)"/>
  </include>

  <node if="$(var launch_fixposition_driver)" pkg="fixposition_driver_ros2" exec="fixposition_driver_ros2_exec" name="fixposition_driver" output="screen">
    <param from="$(var fixposition_config_path)"/>
    <remap from="/fixposition/poiimu" to="/sensing/imu/imu_data"/>
    <remap from="/tf" to="/fixposition/tf"/>
    <remap from="/tf_static" to="/fixposition/tf_static"/>
  </node>
</launch>
