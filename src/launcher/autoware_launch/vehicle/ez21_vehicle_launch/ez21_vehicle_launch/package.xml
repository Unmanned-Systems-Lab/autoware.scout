<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ez21_vehicle_launch</name>
  <version>0.1.0</version>
  <description>Vehicle interface skeleton package for EZ21 vehicles.</description>
  <maintainer email="ez21@example.com">ez21</maintainer>
  <license>Apache 2.0 License</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>autoware_control_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>rclcpp</depend>
  <depend>ros2_socketcan</depend>
  <depend>tier4_vehicle_msgs</depend>

  <exec_depend>autoware_raw_vehicle_cmd_converter</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
