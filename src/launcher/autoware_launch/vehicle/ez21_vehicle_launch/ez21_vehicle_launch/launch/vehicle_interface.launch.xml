<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg
    name="raw_vehicle_cmd_converter_param_path"
    default="$(find-pkg-share autoware_raw_vehicle_cmd_converter)/config/raw_vehicle_cmd_converter.param.yaml"/>
  <arg name="initial_engage_state" default="false"/>
  <arg
    name="vehicle_interface_can_interface"
    default="can0"
    description="SocketCAN interface used by the EZ21 vehicle interface"/>
  <arg
    name="vehicle_interface_param_path"
    default="$(find-pkg-share ez21_vehicle_launch)/config/vehicle_interface.param.yaml"/>

  <node
    pkg="ez21_vehicle_launch"
    exec="ez21_vehicle_interface_node"
    name="ez21_vehicle_interface"
    output="screen">
    <param from="$(var vehicle_interface_param_path)"/>
    <param name="vehicle_id" value="$(var vehicle_id)"/>
    <param name="can_interface" value="$(var vehicle_interface_can_interface)"/>

    <remap from="input/control_cmd" to="/control/command/control_cmd"/>
    <remap from="input/gear_cmd" to="/control/command/gear_cmd"/>
    <remap from="input/turn_indicators_cmd" to="/control/command/turn_indicators_cmd"/>
    <remap from="input/hazard_lights_cmd" to="/control/command/hazard_lights_cmd"/>
    <remap from="input/control_mode_request" to="/control/control_mode_request"/>
    <remap from="output/velocity_status" to="/vehicle/status/velocity_status"/>
    <remap from="output/steering_status" to="/vehicle/status/steering_status"/>
    <remap from="output/gear_status" to="/vehicle/status/gear_status"/>
    <remap from="output/control_mode" to="/vehicle/status/control_mode"/>
  </node>
</launch>
