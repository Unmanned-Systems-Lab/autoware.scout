<?xml version="1.0"?>
<package format="3">
  <name>scout_ht_traversability</name>
  <version>0.1.0</version>
  <description>Read-only robot-to-cell HT and costmap fusion for Scout.</description>
  <maintainer email="maintainers@unmanned-systems-lab.invalid">Unmanned Systems Lab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>grid_map_msgs</exec_depend>
